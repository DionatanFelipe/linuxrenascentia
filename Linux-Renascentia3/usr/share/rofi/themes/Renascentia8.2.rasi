
/* ==========================================
   RENAISSANCE — ROFI 2.0
   UNIFIED PETROL / ANTIQUE GOLD
   ========================================== */

* {
    font: "Iosevka Nerd Font Medium 11";
    background-color: transparent;
    text-color: #E8DFCE;
}

/* WINDOW */
window {
    background-color: #10231F;
    border: 1px;
    border-color: #647D78;
    border-radius: 13px;
}

/* MAIN */
mainbox {
    background-color: transparent;
    padding: 14px;
    spacing: 12px;
}

/* SEARCH */
inputbar {
    background-color: #182C29;
    border: 0px;
    border-radius: 9px;
    padding: 13px 15px;
    spacing: 10px;
}

prompt {
    text-color: #B58A4B;
}

entry {
    background-color: transparent;
    text-color: #E8DFCE;
    placeholder-color: #84969A;
}

/* LIST */
listview {
    background-color: transparent;
    border: 0px;
    padding: 3px;
    spacing: 4px;
    lines: 10;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
}

/* ALL APPLICATIONS */
element {
    background-color: transparent;
    border: 0px;
    border-radius: 9px;
    padding: 10px 12px;
    spacing: 12px;
    text-color: #E8DFCE;
}

/* NORMAL — ONE UNIFIED COLOR */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: #E8DFCE;
}

/* SELECTED — ANTIQUE GOLD */
element selected.normal {
    background-color: #B58A4B;
    text-color: #17251F;
    border: 0px;
}

/* ICONS */
element-icon {
    background-color: transparent;
    size: 24px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

/* URGENT */
element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: #C77B73;
}

element selected.urgent {
    background-color: #A14B4B;
    text-color: #FFFFFF;
}

/* SCROLLBAR */
scrollbar {
    background-color: transparent;
    handle-color: #B58A4B;
    handle-width: 3px;
}

/* MESSAGE */
message {
    background-color: transparent;
    border: 0px;
}

textbox {
    background-color: transparent;
    text-color: #E8DFCE;
}

