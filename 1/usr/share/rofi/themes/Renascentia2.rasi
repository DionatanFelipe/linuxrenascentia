* {
  font: "Iosevka Nerd Font Medium 11";

  bg0     : rgba(10,15,12);
  bg1     : rgba(15,26,20);
  bg2     : rgba(18,38,29);
  bg3     : rgba(30,58,46);

  fg0     : rgb(230,230,230);
  fg1     : rgb(200,200,200);

  green   : rgb(0,255,156);
  copper  : rgb(205,127,50);
  accent  : rgb(205,127,50);
  urgent  : rgb(255,79,79);

  background-color : transparent;
  text-color       : rgb(230,230,230);
}

/* ===== WINDOW ===== */
window {
  background-color: rgba(15,26,20,0.5);
  border: 1px;
  border-color: rgb(205,127,50);
  border-radius: 3px;
}

/* ===== INPUT ===== */
inputbar {
  spacing: 6px;
  padding: 8px 10px;

  background-color: rgba(15,26,20,0.5);
  border: 1px;
  border-color: rgb(205,127,50);

  text-color: rgb(255,255,255);
}

entry {
  text-color: rgb(255,255,255);
  background-color: transparent;
}

icon-search {
  color: rgb(205,127,50);
}

/* ===== LIST ===== */
listview {
  padding: 6px;
  lines: 10;
  columns: 1;
  fixed-height: false;
  dynamic: true;
}

/* ===== ELEMENTOS ===== */
element {
  padding: 6px 10px;
  background-color: rgba(18,38,29,0.5);
  border-radius: 2px;
  text-color: rgb(230,230,230);
}

/* hover */
element selected {
  background-color: rgb(205,127,50);
  text-color: rgb(10,15,12);
}

/* alternado */
element alternate {
  background-color: rgba(15,26,20,0.5);
}

/* urgente */
element normal urgent {
  text-color: rgb(255,79,79);
}

/* ===== SCROLLBAR ===== */
scrollbar {
  handle-width: 4px;
  handle-color: rgb(205,127,50);
}
