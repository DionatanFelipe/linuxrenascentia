/**
 * ROFI Theme - Renascentia Premium - Couro/Bronze Compatível
 */

* {
    font: "Iosevka Nerd Font Medium 11";

    /* Fundos principais */
    bg0: #0A0F0C;
    bg1: #0F1A14;
    bg2: #12261D;
    bg3: #1E3A2E;

    /* Textos */
    fg0: #E6E6E6;
    fg1: #C8C8C8;

    /* Destaques */
    green: #3A6B48;
    copper: #AA5F32;
    accent: #C27C4A;
    urgent: #DC3C3C;

    background-color: #0F1A14;
    text-color: #E6E6E6;
}

/* ===== WINDOW ===== */
window {
    background-color: #0F1A14;
    border: 1px;
    border-color: #AA5F32;
    border-radius: 3px;
}

/* ===== INPUT ===== */
inputbar {
    spacing: 6px;
    padding: 8px 10px;
    background-color: #0F1A14;
    border: 1px;
    border-color: #AA5F32;
    text-color: #E6E6E6;
}

entry {
    text-color: #E6E6E6;
    background-color: #0F1A14;
}

icon-search {
    color: #C27C4A;
}

/* ===== LIST ===== */
listview {
    padding: 6px;
    lines: 10;
    columns: 1;
    fixed-height: false;
    dynamic: true;
}

/* ===== ELEMENTOS ===== */
element {
    padding: 6px 10px;
    background-color: rgba(42,30,18,0.9);  /* couro renascentista */
    border: 1px;
    border-color: #AA5F32;  /* bronze suave */
    border-radius: 2px;
    text-color: #E6E6E6;
}

/* alternado */
element alternate {
    background-color: rgba(31,20,12,0.9);  /* mais escuro */
}

/* hover / selecionado */
element selected {
    background-color: rgba(205,127,50,0.25);  /* bronze discreto */
    border: 1px;
    border-color: #C27C4A;
    text-color: #E6E6E6;
}

/* urgente */
element normal urgent {
    text-color: #DC3C3C;
    background-color: rgba(42,30,18,0.9);
    border: 1px;
    border-color: #C27C4A;
}

/* ===== SCROLLBAR ===== */
scrollbar {
    handle-width: 4px;
    handle-color: #C27C4A;
}
